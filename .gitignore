# build output
dist/
# lib/ is shipped on purpose: the GitHub-tarball install must be extract-only
# (no build scripts, no devDependencies fetch — pnpm >= 11 blocks those behind
# allowBuilds). `pnpm build` before commit when src/ changed; `prepack` still
# rebuilds at npm-pack time.
*.tgz
.npm-cache/

# dependencies (the plugin itself has none)
node_modules/

# local memory workspaces, should you point one here while developing
.memory/

# editor / OS noise
.DS_Store
Thumbs.db
*.log
